# ============================================================
#  Copia este archivo como .env y completa los valores.
#  NUNCA subas el .env a GitHub (ya está en .gitignore).
# ============================================================

# --- SQL Server (Exact Globe) ---
DB_SERVER=cmch-dc1
# Si SQL Server corre como instancia con nombre (p. ej. cmch-dc1\EXACT), pon aquí el nombre:
DB_INSTANCE=
# Puerto fijo (déjalo vacío si usas instancia con nombre y SQL Browser):
DB_PORT=1433
# Base donde están las vistas (01_base_y_sinonimos.sql). Los sinónimos apuntan a [900].
DB_NAME=PedidosApp
DB_USER=app_pedidos_ro
DB_PASSWORD=CAMBIAR-esta-Clave-2026!
# true si el servidor exige cifrado TLS; con certificado autofirmado deja TRUST_CERT=true
DB_ENCRYPT=false
DB_TRUST_CERT=true

# --- API ---
PORT=8080
# Segundos que se reutiliza una respuesta antes de volver a consultar SQL.
# Con 15 s, 50 teléfonos abiertos generan como máximo 1 consulta cada 15 s.
CACHE_TTL=15
# Códigos de acceso: Nombre:codigo separados por ;  (vacío = sin control de acceso, solo para pruebas)
APP_TOKENS=Rafael:cambia-este-codigo;Ventas:otro-codigo-largo
# Orígenes extra permitidos (app Android empaquetada con Capacitor)
CORS_ORIGINS=https://localhost,http://localhost,capacitor://localhost

# 1 = datos de demostración (sin SQL Server), útil para probar la app
DEMO=0
